{
  "name": "presentation-app",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "node ./scripts/lint.mjs",
    "test": "node ./scripts/test-build.mjs",
    "ci": "npm run lint && npm test && npm run build",
    "build:css": "tailwindcss -i ./src/styles.css -o ./assets/styles.css --minify",
    "build:dist": "node ./scripts/build-dist.mjs",
    "inline-icons": "node ./scripts/inline-icons.mjs",
    "build": "npm run inline-icons && npm run build:css && npm run build:dist"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "lucide": "^1.39.0",
    "tailwindcss": "^4.1.8"
  }
}
